{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Tinker Access Server",
            "program": "${workspaceFolder}/tinker-access-server-rs/target/debug/tinker-access-server-rs",
            "args": [],
            "cwd": "${workspaceFolder}/tinker-access-server-rs",
            "env": {
                "LEPTOS_OUTPUT_NAME": "tinker-access-server-rs",
                "LEPTOS_SITE_ROOT": "target/site",
                "LEPTOS_SITE_PKG_DIR": "pkg",
                "LEPTOS_SITE_ADDR": "127.0.0.1:3000",
                "LEPTOS_RELOAD_PORT": "3001",
                "DATABASE_URL": "sqlite:${workspaceFolder}/tinker-access-server-rs/db.sqlite"
            },
            "preLaunchTask": "cargo leptos build",
            "sourceLanguages": ["rust"]
        },
        {
            "name": "Debug Rust Tests (tinker-access-server-rs)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/tinker-access-server-rs/target/debug/deps/tinker-access-server-rs-test",
            "preLaunchTask": "build-test-binary",
            "args": [],
            "cwd": "${workspaceFolder}/tinker-access-server-rs",
            "env": {
                "RUST_BACKTRACE": "1",
                "LEPTOS_OUTPUT_NAME": "tinker-access-server-rs",
                "LEPTOS_SITE_ROOT": "target/site",
                "LEPTOS_SITE_PKG_DIR": "pkg",
                "LEPTOS_SITE_ADDR": "127.0.0.1:3000",
                "LEPTOS_RELOAD_PORT": "3001",
                "DATABASE_URL": "sqlite:${workspaceFolder}/tinker-access-server-rs/db.sqlite"
            }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Test Binary",
            "cargo": {
              "args": [
                "test",
                "--no-run",
                "--tests",
                "--features",
                "ssr"
              ],
            "cwd": "${workspaceFolder}/tinker-access-server-rs",
            },
            "filter": {
                "kind": "test"
            },
            "args": [],
            "cwd": "${workspaceFolder}/tinker-access-server-rs",
        }
    ]
}